# ========================================
# Image Worker - 環境變數設定
# ========================================
# 硬體需求: RTX 5090 32GB VRAM
#
# 使用方法:
# 1. 複製此檔案為 .env
#    cp .env.example .env
# 2. 修改 API_BASE_URL 為主機 IP
# 3. 修改 S3_ENDPOINT 為主機 MinIO IP
# ========================================

# --- API 連線設定 ---
# 修改為主機（API Server）的 IP 位址
API_BASE_URL=http://192.168.1.100:8000

# --- MinIO 連線設定 ---
# 修改為主機 MinIO 的 IP 位址
# 如果使用 HTTPS 且憑證不匹配，設置 S3_SKIP_SSL_VERIFY=true
S3_ENDPOINT=http://192.168.1.100:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=assets
S3_SKIP_SSL_VERIFY=true

# --- Worker 設定 ---
WORKER_ID=image-01
WORKER_HOSTNAME=image-worker

# --- ComfyUI 設定 ---
# 如果 ComfyUI 在同一台機器，使用 localhost
# 如果 ComfyUI 在其他機器，修改為該機器 IP
COMFYUI_API_URL=http://localhost:8188

# --- 模型設定 ---
# saladtechnologies 映像內建 DreamShaper 8 模型
# 如需使用自訂模型，放置於 ./models/sd/ 目錄，並設定 SD_MODEL_NAME
SD_MODEL_NAME=dreamshaper_8.safetensors

# --- 圖片生成參數 ---
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
CFG_SCALE=7.5
NUM_INFERENCE_STEPS=30
SAMPLER=euler_ancestral
